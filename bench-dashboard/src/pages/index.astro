---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---
<Base title="Synapse — Live Bench Dashboard">
  <header class="hero">
    <h1>Synapse <span>·</span> Live Bench</h1>
    <p class="lead">
      Reproducible benchmarks against MariaDB, fastembed, and SQLite.
      SHA pinned. Every number below was measured on 2026-04-25 against the
      <code>session-2026-04-25-ultrathink</code> branch.
    </p>
    <span class="badge">Verified 2026-04-25 · M4 Max · 128 GB RAM</span>

    <div class="grid3">
      <div class="stat">
        <div class="label">WordPress Lex p50</div>
        <div class="value">4.5 ms</div>
        <div class="sub">PHP plugin, persistent socket. <strong>21.6×</strong> faster than the pre-fix client (97.1 ms). Beats the Python direct baseline.</div>
      </div>
      <div class="stat">
        <div class="label">OLTP @ 8 threads</div>
        <div class="value">7,153 OPS</div>
        <div class="sub">Up from 2,190 (<strong>3.27×</strong>). Matches MariaDB (7,626 OPS) — and Synapse runs the real point-select with SQLite I/O, not <code>SELECT 1</code>.</div>
      </div>
      <div class="stat">
        <div class="label">MLX Vec p95 tail</div>
        <div class="value">−48%</div>
        <div class="sub">90.8 ms vs 174.3 ms on fastembed CPU. Sub-100 ms p95 across the board on Metal. Parity 1.0000 vs fastembed.</div>
      </div>
    </div>
  </header>

  <main>
    <h2>What changed today</h2>
    <ul>
      <li><strong>WP install</strong> — <code>wp core install</code> now succeeds end-to-end on the SQLite-backed shim. Round-trip INSERT → LAST_INSERT_ID → SELECT verified. <a href={`${base}/wordpress/`}>Details →</a></li>
      <li><strong>WP plugin keep-alive</strong> — persistent UNIX socket restored client-side; daemon got a 60 s idle timeout. Lex 21.6×, Hybrid 47.0× faster.</li>
      <li><strong>OLTP gap closed</strong> — regex cache + log-spam removal in <code>shim.rs::on_query</code>. Synapse OLTP now at MariaDB parity for point-select.</li>
      <li><strong>MLX promoted to default</strong> — fastembed retained as graceful fallback. CRIT-2 frame-size DoS bound (256 MiB) added.</li>
    </ul>

    <h2>Headline comparison</h2>
    <table>
      <thead><tr><th>Workload</th><th>Synapse</th><th>Reference</th><th>Status</th></tr></thead>
      <tbody>
        <tr class="highlight">
          <td>WP search (Lex p50)</td>
          <td>4.5 ms</td>
          <td>97.1 ms (pre-fix)</td>
          <td>21.6× faster</td>
        </tr>
        <tr class="highlight">
          <td>WP search (Hybrid p50)</td>
          <td>56.4 ms</td>
          <td>2,649.2 ms (pre-fix)</td>
          <td>47.0× faster</td>
        </tr>
        <tr class="highlight">
          <td>OLTP point-select @ 8t</td>
          <td>7,153 OPS</td>
          <td>MariaDB 7,626 OPS</td>
          <td>Parity</td>
        </tr>
        <tr class="highlight">
          <td>Embed Vec p95 (MLX)</td>
          <td>90.8 ms</td>
          <td>174.3 ms (fastembed CPU)</td>
          <td>−48%</td>
        </tr>
        <tr>
          <td>WP <code>core install</code></td>
          <td>PASS</td>
          <td>—</td>
          <td>End-to-end verified</td>
        </tr>
      </tbody>
    </table>

    <p style="margin-top:2rem;color:var(--muted);font-size:0.9rem;">
      Drill in: <a href={`${base}/wordpress/`}>WordPress</a> ·
      <a href={`${base}/oltp/`}>OLTP</a> ·
      <a href={`${base}/embed/`}>Embed (MLX)</a> ·
      <a href={`${base}/methodology/`}>Methodology</a>
    </p>
  </main>
</Base>
