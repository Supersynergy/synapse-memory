# --- build / deps ---
target/
# Application releases require a committed, reproducible dependency graph.
Cargo.lock
!/Cargo.lock
**/node_modules/
.DS_Store

# --- databases / runtime state ---
*.db
*.db-wal
*.db-shm
*.db-journal
*.brainpack
*.synx
synapse.sk
synapse.vk
.synapse/
.emb-cache/
.fastembed_cache/
.pytest_cache/

# --- caches / generated ---
__pycache__/
**/*.pyc
catboost_info/
*.parquet
*.npy
*.safetensors
graphify-out/

# --- dev tooling / vendored tool repos (not part of synapse) ---
.tools/
.repovista/
.superverify/
.conductor/
**/.claude/

# --- release / packaging artifacts ---
release/dist/
release/dist-memory/
dist/
*.tar.gz
*.tar.gz.sha256

# --- bench data outputs (regenerated by bench scripts) ---
bench/recall_bakeoff/
bench/agentdb_public/
bench/comprehensive/_qdrant_storage/
bench/**/_qdrant_storage/
bench/**/*.parquet
bench/**/__pycache__/
bench/**/target/
bench/**/results*.json

# --- private ---
docs/strategy/

# tooling artifacts
.grepgod/

# crash coredumps (never ship)
core
*.core
