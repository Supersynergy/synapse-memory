---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---
<Base title="Synapse — Live Bench Dashboard v1.0.1">
  <header class="hero">
    <h1>Synapse <span>·</span> Live Bench</h1>
    <p class="lead">
      Reproducible benchmarks against MariaDB, fastembed, and SQLite.
      SHA pinned. Wave 2026-05-11: NEON-RRF, tantivy-warm, ColBERT/SPLADE/Conformal/CRDT-cluster.
    </p>
    <span class="badge">Verified 2026-05-11 · M4 Max · 128 GB RAM</span>

    <div class="grid3">
      <div class="stat">
        <div class="label">NEON-RRF fusion</div>
        <div class="value">4.3–5.1×</div>
        <div class="sub">NEON SIMD reciprocal-rank-fusion vs scalar baseline. M4 Max. Wave 2026-05-11.</div>
      </div>
      <div class="stat">
        <div class="label">tantivy-warm BM25</div>
        <div class="value">18.3×</div>
        <div class="sub">tantivy warm-cache query vs FTS5 cold baseline. p50 latency drop &gt;18×.</div>
      </div>
      <div class="stat">
        <div class="label">MLX Vec p95 tail</div>
        <div class="value">−48%</div>
        <div class="sub">90.8 ms vs 174.3 ms on fastembed CPU. Sub-100 ms p95 on Metal. Parity 1.0000.</div>
      </div>
    </div>
  </header>

  <main>
    <h2>Wave 2026-05-11 — what shipped</h2>
    <ul>
      <li><strong>NEON-RRF</strong> — SIMD reciprocal-rank-fusion <strong>4.3–5.1×</strong> faster than scalar. M4 Max NEON intrinsics + f32 lane-parallel accumulate.</li>
      <li><strong>tantivy-warm</strong> — BM25 warm-cache path <strong>18.3×</strong> faster than FTS5 cold. <code>synapse-fts</code> crate, feature-gated off by default.</li>
      <li><strong>ColBERT multi-vector</strong> — late-interaction scaffold (<code>synapse-colbert</code>), MaxSim kernel, ONNX-ready.</li>
      <li><strong>SPLADE-v3</strong> — neural-sparse inverted-index (<code>synapse-splade</code>), BOW + IDF expansion.</li>
      <li><strong>Split-Conformal</strong> — statistical recall guarantee (<code>conformal</code> feature), calibration on held-out set.</li>
      <li><strong>CRDT-cluster</strong> — multi-node gossip AP cluster (<code>synapse-cluster</code>), convergence in &lt;200 ms LAN.</li>
      <li><strong>MUVERA fusion</strong> — new <code>synapse-fusion</code> crate with <code>muvera_rrf()</code> dense+ColBERT RRF API.</li>
    </ul>

    <h2>Headline comparison</h2>
    <table>
      <thead><tr><th>Workload</th><th>Synapse</th><th>Reference</th><th>Status</th></tr></thead>
      <tbody>
        <tr class="highlight">
          <td>WP search (Lex p50)</td>
          <td>4.5 ms</td>
          <td>97.1 ms (pre-fix)</td>
          <td>21.6× faster</td>
        </tr>
        <tr class="highlight">
          <td>WP search (Hybrid p50)</td>
          <td>56.4 ms</td>
          <td>2,649.2 ms (pre-fix)</td>
          <td>47.0× faster</td>
        </tr>
        <tr class="highlight">
          <td>OLTP point-select @ 8t</td>
          <td>7,153 OPS</td>
          <td>MariaDB 7,626 OPS</td>
          <td>Parity</td>
        </tr>
        <tr class="highlight">
          <td>Embed Vec p95 (MLX)</td>
          <td>90.8 ms</td>
          <td>174.3 ms (fastembed CPU)</td>
          <td>−48%</td>
        </tr>
        <tr>
          <td>WP <code>core install</code></td>
          <td>PASS</td>
          <td>—</td>
          <td>End-to-end verified</td>
        </tr>
      </tbody>
    </table>

    <p style="margin-top:2rem;color:var(--muted);font-size:0.9rem;">
      Drill in: <a href={`${base}/wordpress/`}>WordPress</a> ·
      <a href={`${base}/oltp/`}>OLTP</a> ·
      <a href={`${base}/embed/`}>Embed (MLX)</a> ·
      <a href={`${base}/methodology/`}>Methodology</a>
    </p>
  </main>
</Base>
