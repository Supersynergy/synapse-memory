# Synapse Linux bench image — aarch64 + amd64
# Build: docker build -f Dockerfile.bench -t synapse:linux-bench .
# Run:   docker run --rm -v $(pwd):/app synapse:linux-bench /app/scripts/linux-bench.sh
#
# Strategy: pre-install Rust toolchain + build deps only.
# Cargo build happens at run-time with bind-mount (reuses host cargo cache if mounted).
FROM rust:slim-bookworm

RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libsqlite3-dev \
    clang \
    lld \
    cmake \
    curl \
    git \
    python3 \
    python3-pip \
    python3-numpy \
    && rm -rf /var/lib/apt/lists/*

# faiss-cpu best-effort (Python leg of raw_ann_microbench)
RUN pip3 install --break-system-packages faiss-cpu 2>/dev/null || true

WORKDIR /app

# Default: compile + run raw_ann_microbench + tests
CMD ["bash", "-c", \
  "cargo build --release -p synapse-ann --features ann-usearch --example raw_ann_microbench 2>&1 && \
   cargo run --release -p synapse-ann --features ann-usearch --example raw_ann_microbench && \
   cargo bench -p synapse-fts --bench fts_compare 2>&1 | tail -40 && \
   cargo bench -p synapse-core --bench rrf_neon 2>&1 | tail -40 && \
   cargo test --workspace --release --quiet 2>&1 | tail -20" \
]
